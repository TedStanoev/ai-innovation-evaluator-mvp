# Server port (Cloud Run defaults to 8080; local dev uses 4000)
PORT=4000

# Comma-separated list of allowed CORS origins (local dev + Firebase Hosting URLs)
CLIENT_ORIGIN=http://localhost:3000,https://YOUR_FIREBASE_PROJECT_ID.web.app,https://YOUR_FIREBASE_PROJECT_ID.firebaseapp.com

# Google GenAI / ADK API Key (Replace with your actual Gemini API Key)
GEMINI_API_KEY=YOUR_KEY_HERE
GOOGLE_GENAI_API_KEY=YOUR_KEY_HERE

# Firebase Admin SDK Configuration (Optional on Cloud Run when using Application Default Credentials)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"
