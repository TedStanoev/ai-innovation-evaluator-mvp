{
  "name": "ai-innovation-evaluator-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "adk:web": "adk web src/agents",
    "adk:run:auditor": "adk run src/agents/auditorAgent.ts",
    "adk:run:mentor": "adk run src/agents/mentorAgent.ts"
  },
  "dependencies": {
    "@google/adk": "^2.4.0",
    "@google/genai": "^2.29.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "firebase-admin": "^13.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@google/adk-devtools": "^2.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
